{
  "name": "proofread",
  "version": "0.1.0",
  "private": true,
  "description": "A second set of eyes for every design. A Figma plugin that reviews a selection for consistency, accessibility, and design-system issues.",
  "scripts": {
    "build:ui": "vite build",
    "build:main": "esbuild src/controller/main.ts --bundle --outfile=dist/code.js --target=es2017",
    "build": "npm run build:main && npm run build:ui",
    "watch:ui": "vite build --watch",
    "watch:main": "esbuild src/controller/main.ts --bundle --outfile=dist/code.js --target=es2017 --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
